# ============ AUTHENTICATION (JWT) ============
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ============ DATABASE ============
# Phase 1-3: SQLite
DATABASE_URL=sqlite:///./clara.db

# Phase 2+: PostgreSQL (uncomment when ready)
# DATABASE_URL=postgresql://clara_user:clara_password@localhost:5432/clara

# ============ LLM PROVIDER (Phase 4) ============
# Choose provider: gemini, openai, or mock
# Default: gemini (free, no charges)
LLM_PROVIDER=gemini

# Google Gemini (FREE tier available)
# Get free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000
GEMINI_TIMEOUT_SECONDS=30

# OpenAI (Optional, costs money)
# Get API key from: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4-turbo
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=1000
# OPENAI_TIMEOUT_SECONDS=30

# LLM Intent Validation
LLM_ENABLE_INTENT_VALIDATION=true

# ============ LOGGING ============
LOG_LEVEL=INFO
